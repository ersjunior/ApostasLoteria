# Exemplo de secrets para Streamlit Community Cloud
# Copie este arquivo em "Secrets" no painel do app (Settings → Secrets)
# ou renomeie localmente para secrets.toml (não versionar).

LOTTERIAS_DB_PATH = "app/data/loterias.db"

# Opcional: variáveis da API (se hospedar separadamente — a API NÃO roda no Community Cloud)
# ENVIRONMENT = "production"
# CORS_ORIGINS = "https://seu-app.streamlit.app"
